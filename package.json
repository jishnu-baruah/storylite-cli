{
    "name": "storylite-cli",
    "version": "1.0.6",
    "description": "The cURL for Intellectual Property - Transform any file into a registered IP asset with one command",
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "storylite": "./bin/storylite"
    },
    "homepage": "https://github.com/jishnu-baruah/storylite-cli",
    "repository": {
        "type": "git",
        "url": "https://github.com/jishnu-baruah/storylite-cli.git"
    },
    "bugs": {
        "url": "https://github.com/jishnu-baruah/storylite-cli/issues"
    },
    "scripts": {
        "build": "npm run clean && tsc",
        "build:watch": "tsc --watch",
        "clean": "rimraf dist",
        "dev": "npm run build:watch",
        "start": "node dist/index.js",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:integration": "npm run build && node test-integration.cjs",
        "test:all": "npm run test && npm run test:integration",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "format": "prettier --write \"src/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\"",
        "verify": "npm run lint && npm run format:check && npm run test:all",
        "package:test": "npm pack --dry-run",
        "package:local": "npm pack && npm install -g storylite-cli-*.tgz",
        "package:uninstall": "npm uninstall -g storylite-cli",
        "prepublishOnly": "npm run lint && npm run format:check && npm run test:integration && npm run build",
        "postbuild": "node -e \"try { require('fs').chmodSync('bin/storylite', '755'); } catch(e) { /* Windows doesn't need chmod */ }\""
    },
    "keywords": [
        "cli",
        "ip",
        "intellectual-property",
        "story-protocol",
        "blockchain",
        "nft",
        "mint",
        "copyright",
        "patent",
        "creator",
        "developer-tools",
        "web3",
        "ethereum"
    ],
    "author": {
        "name": "Jishnu Baruah",
        "email": "jishnu.baruah@example.com",
        "url": "https://github.com/jishnu-baruah"
    },
    "license": "MIT",
    "funding": {
        "type": "github",
        "url": "https://github.com/sponsors/jishnu-baruah"
    },
    "dependencies": {
        "@story-protocol/core-sdk": "^1.4.2",
        "axios": "^1.6.2",
        "chalk": "^5.3.0",
        "commander": "^11.1.0",
        "conf": "^12.0.0",
        "ora": "^7.0.1",
        "viem": "^2.7.0"
    },
    "devDependencies": {
        "@types/jest": "^29.5.8",
        "@types/node": "^20.10.0",
        "@typescript-eslint/eslint-plugin": "^6.13.0",
        "@typescript-eslint/parser": "^6.13.0",
        "eslint": "^8.54.0",
        "fast-check": "^3.15.0",
        "jest": "^29.7.0",
        "prettier": "^3.1.0",
        "rimraf": "^5.0.5",
        "ts-jest": "^29.1.1",
        "typescript": "^5.3.2"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}
